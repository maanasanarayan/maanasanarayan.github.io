---
import { Mail, Copy, CheckCircle2 } from 'lucide-astro';

interface ContactData {
  email: string;
  linkedin: string;
  github: string;
  twitter: string;
  twitterHandle: string;
}

interface Props {
  contact: ContactData;
}

const { contact } = Astro.props;
---

<div
  class="text-neo-bg relative overflow-hidden border-4 border-black bg-black p-8 shadow-[12px_12px_0_0_#FFD93D] sm:p-10 lg:p-12"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-30"
    style={{
      backgroundImage: 'radial-gradient(#FFD93D 1.5px, transparent 1.5px)',
      backgroundSize: '22px 22px',
    }}
  >
  </div>
  <div
    class="relative grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.6fr)] lg:gap-12"
  >
    <div>
      <h3
        class="font-display text-2xl tracking-tight text-white uppercase sm:text-3xl"
      >
        Get in Touch
      </h3>
      <p class="mt-2 max-w-md text-base leading-snug font-medium sm:text-lg">
        Let&apos;s talk &mdash; projects, technical challenges, or just a hello.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5">
      <!-- Email Copy Button -->
      <button
        id="copy-email-btn"
        type="button"
        data-email={contact.email}
        class="group border-neo-bg bg-neo-accent text-neo-ink no-print flex min-w-0 cursor-pointer items-center gap-4 border-4 p-4 text-left shadow-[6px_6px_0_0_#fff] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#fff] active:translate-x-1.5 active:translate-y-1.5 active:shadow-none sm:p-5"
      >
        <span
          class="grid h-12 w-12 shrink-0 place-items-center border-2 border-black bg-white"
        >
          <Mail class="h-5 w-5 stroke-[3px] text-black" />
        </span>
        <span class="min-w-0 flex-1">
          <span
            class="block text-[11px] font-bold tracking-widest uppercase opacity-80"
          >
            Email · click to copy
          </span>
          <span
            class="font-display block overflow-hidden text-base tracking-tight text-ellipsis whitespace-nowrap uppercase sm:text-lg"
          >
            {contact.email}
          </span>
        </span>
        <Copy
          class="h-4 w-4 shrink-0 stroke-[3px] opacity-70 group-hover:opacity-100"
        />
      </button>

      <!-- LinkedIn -->
      <a
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group border-neo-bg bg-neo-secondary text-neo-ink flex min-w-0 items-center gap-4 border-4 p-4 text-left shadow-[6px_6px_0_0_#fff] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#fff] active:translate-x-1.5 active:translate-y-1.5 active:shadow-none sm:p-5"
      >
        <span
          class="grid h-12 w-12 shrink-0 place-items-center border-2 border-black bg-white"
        >
          <svg
            class="h-5 w-5 stroke-[3px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </span>
        <span class="min-w-0 flex-1">
          <span
            class="block text-[11px] font-bold tracking-widest uppercase opacity-80"
          >
            Network
          </span>
          <span
            class="font-display block overflow-hidden text-base tracking-tight text-ellipsis whitespace-nowrap uppercase sm:text-lg"
          >
            LinkedIn
          </span>
        </span>
      </a>

      <!-- GitHub -->
      <a
        href={contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group border-neo-bg bg-neo-muted text-neo-ink flex min-w-0 items-center gap-4 border-4 p-4 text-left shadow-[6px_6px_0_0_#fff] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#fff] active:translate-x-1.5 active:translate-y-1.5 active:shadow-none sm:p-5"
      >
        <span
          class="grid h-12 w-12 shrink-0 place-items-center border-2 border-black bg-white"
        >
          <svg
            class="h-5 w-5 stroke-[3px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path>
          </svg>
        </span>
        <span class="min-w-0 flex-1">
          <span
            class="block text-[11px] font-bold tracking-widest uppercase opacity-80"
          >
            Code
          </span>
          <span
            class="font-display block overflow-hidden text-base tracking-tight text-ellipsis whitespace-nowrap uppercase sm:text-lg"
          >
            GitHub
          </span>
        </span>
      </a>

      <!-- Posts / X -->
      <a
        href={contact.twitter}
        target="_blank"
        rel="noopener noreferrer"
        class="group border-neo-bg bg-neo-mint text-neo-ink flex min-w-0 items-center gap-4 border-4 p-4 text-left shadow-[6px_6px_0_0_#fff] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#fff] active:translate-x-1.5 active:translate-y-1.5 active:shadow-none sm:p-5"
      >
        <span
          class="grid h-12 w-12 shrink-0 place-items-center border-2 border-black bg-white"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </span>
        <span class="min-w-0 flex-1">
          <span
            class="block text-[11px] font-bold tracking-widest uppercase opacity-80"
          >
            Posts
          </span>
          <span
            class="font-display block overflow-hidden text-base tracking-tight text-ellipsis whitespace-nowrap uppercase sm:text-lg"
          >
            {contact.twitterHandle}
          </span>
        </span>
      </a>
    </div>
  </div>
</div>

<!-- Toast notification -->
<div
  id="email-toast"
  role="status"
  aria-live="polite"
  class="no-print bg-neo-secondary pointer-events-none fixed bottom-6 left-1/2 z-[100] inline-flex -translate-x-1/2 translate-y-4 items-center gap-2 border-4 border-black px-5 py-3 text-sm font-bold tracking-widest uppercase opacity-0 shadow-[6px_6px_0_0_#000] transition-all duration-200"
>
  <CheckCircle2 class="h-5 w-5 stroke-[3px]" />
  <span id="toast-message">Email copied!</span>
</div>

<script is:inline type="module">
  (function () {
    const btn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('email-toast');
    let timeout;

    if (btn && toast) {
      btn.addEventListener('click', async function () {
        const email = btn.getAttribute('data-email');
        if (email && navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(email);
            clearTimeout(timeout);
            toast.classList.remove(
              'opacity-0',
              'translate-y-4',
              'pointer-events-none',
            );
            toast.classList.add('opacity-100', 'translate-y-0');
            timeout = setTimeout(function () {
              toast.classList.remove('opacity-100', 'translate-y-0');
              toast.classList.add(
                'opacity-0',
                'translate-y-4',
                'pointer-events-none',
              );
            }, 2500);
          } catch (err) {
            console.debug('Clipboard write failed:', err);
          }
        }
      });
    }
  })();
</script>
