---
/**
 * Blog search: a trigger button plus a native modal <dialog> palette.
 *
 * Nothing search-related is fetched at page load. Pagefind's JS API
 * (/pagefind/pagefind.js, generated by `pagefind --site dist/client` in the
 * build script) is imported on first open, or when the trigger is hovered or
 * focused, and every query is scoped to `section:Blog` so other sections that
 * share the index (e.g. art) never show up here.
 *
 * Opens with the button, "/" (outside text fields) or Cmd/Ctrl+K. The dialog
 * gives focus containment, Esc and the top layer for free; arrow keys move
 * the active option via aria-activedescendant and Enter opens it.
 */
import { Search, X } from 'lucide-astro';
---

<button
  type="button"
  data-blog-search-open
  aria-haspopup="dialog"
  aria-controls="blog-search"
  class="hover:bg-neo-mint inline-flex h-12 items-center gap-3 border-4 border-black bg-white px-4 text-xs font-bold tracking-widest uppercase shadow-[4px_4px_0_0_#000] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_#000] active:translate-x-1 active:translate-y-1 active:shadow-none"
>
  <Search class="h-4 w-4 stroke-[3px]" aria-hidden="true" />
  Search posts
  <kbd
    class="hidden border-2 border-black bg-black px-1.5 py-0.5 font-mono text-[0.7rem] leading-none text-white sm:inline-block"
    aria-hidden="true"
  >
    /
  </kbd>
</button>

<dialog
  id="blog-search"
  class="blog-search m-auto w-[calc(100%-2rem)] max-w-2xl border-0 bg-transparent p-0 text-black"
  aria-labelledby="blog-search-title"
>
  <div class="flex max-h-[min(80dvh,40rem)] flex-col border-4 border-black bg-white shadow-[10px_10px_0_0_#000]">
    <div class="bg-neo-secondary flex items-center justify-between gap-3 border-b-4 border-black px-4 py-2">
      <h2
        id="blog-search-title"
        class="font-display text-lg tracking-tight uppercase"
      >
        Search the blog
      </h2>
      <button
        type="button"
        data-blog-search-close
        aria-label="Close search"
        class="grid h-10 w-10 place-items-center border-2 border-black bg-white shadow-[2px_2px_0_0_#000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
      >
        <X class="h-5 w-5 stroke-[3px]" aria-hidden="true" />
      </button>
    </div>

    <form
      role="search"
      class="focus-within:bg-neo-mint/40 flex items-center gap-3 border-b-4 border-black px-4"
      data-blog-search-form
    >
      <Search class="h-5 w-5 shrink-0 stroke-[3px]" aria-hidden="true" />
      <input
        type="search"
        name="q"
        data-blog-search-input
        role="combobox"
        aria-label="Search posts"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="blog-search-results"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        maxlength="80"
        placeholder="Type to search posts…"
        class="h-14 min-w-0 flex-1 bg-transparent text-lg font-bold placeholder:text-black/60 focus:outline-none [&::-webkit-search-cancel-button]:appearance-none"
      />
    </form>

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-3">
      <div
        id="blog-search-results"
        role="listbox"
        aria-label="Search results"
        class="flex flex-col gap-3"
        data-blog-search-results
        hidden
      ></div>
      <p
        role="status"
        aria-live="polite"
        class="px-1 py-2 text-sm font-bold"
        data-blog-search-status
      >
        Start typing to search every post.
      </p>
    </div>

    <p
      class="hidden gap-5 border-t-4 border-black px-4 py-2 font-mono text-xs sm:flex"
      aria-hidden="true"
    >
      <span>↑↓ move</span>
      <span>↵ open</span>
      <span>esc close</span>
    </p>
  </div>
</dialog>

<style>
  .blog-search::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-search[open] > div {
      transition:
        translate 180ms ease-out,
        opacity 180ms ease-out;
    }
    @starting-style {
      .blog-search[open] > div {
        opacity: 0;
        translate: 0 -12px;
      }
    }
  }

  .blog-search :global(.search-option) {
    display: block;
    border: 3px solid #000;
    background: #fff;
    padding: 0.75rem 1rem;
    box-shadow: 3px 3px 0 0 #000;
  }
  .blog-search :global(.search-option[aria-selected='true']) {
    background: var(--color-neo-mint);
    box-shadow: 5px 5px 0 0 #000;
  }
  .blog-search :global(.search-option-title) {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.05rem;
    line-height: 1.15;
  }
  .blog-search :global(.search-option-excerpt) {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .blog-search :global(mark) {
    background: var(--color-neo-secondary);
    color: #000;
    font-weight: 700;
  }
</style>

<script>
  interface PagefindResult {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }
  interface PagefindApi {
    options?: (opts: Record<string, unknown>) => Promise<void>;
    init?: () => Promise<void>;
    debouncedSearch: (
      query: string,
      opts?: Record<string, unknown>,
      ms?: number,
    ) => Promise<{
      results: { data: () => Promise<PagefindResult> }[];
    } | null>;
  }

  const dialog = document.getElementById(
    'blog-search',
  ) as HTMLDialogElement | null;
  const input = dialog?.querySelector<HTMLInputElement>(
    '[data-blog-search-input]',
  );
  const list = dialog?.querySelector<HTMLElement>('[data-blog-search-results]');
  const status = dialog?.querySelector<HTMLElement>(
    '[data-blog-search-status]',
  );
  const form = dialog?.querySelector<HTMLFormElement>(
    '[data-blog-search-form]',
  );
  const IDLE = 'Start typing to search every post.';

  let pagefind: Promise<PagefindApi | null> | null = null;
  const loadPagefind = () => {
    // A runtime string keeps Vite from trying to bundle the build artefact.
    const url = '/pagefind/pagefind.js';
    pagefind ??= import(/* @vite-ignore */ url)
      .then(async (mod: PagefindApi) => {
        await mod.options?.({ excerptLength: 22 });
        await mod.init?.();
        return mod;
      })
      .catch(() => null);
    return pagefind;
  };

  let urls: string[] = [];
  let active = -1;
  let token = 0;
  let opener: HTMLElement | null = null;

  /** Copy Pagefind's excerpt into safe DOM, keeping only <mark> highlights. */
  const appendExcerpt = (html: string, target: HTMLElement) => {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    for (const node of doc.body.childNodes) {
      if (node instanceof HTMLElement && node.tagName === 'MARK') {
        const mark = document.createElement('mark');
        mark.textContent = node.textContent;
        target.append(mark);
      } else {
        target.append(node.textContent ?? '');
      }
    }
  };

  const setActive = (index: number) => {
    if (!list || !input) return;
    const options = list.querySelectorAll<HTMLElement>('[role="option"]');
    active = options.length
      ? Math.max(0, Math.min(index, options.length - 1))
      : -1;
    options.forEach((o, i) =>
      o.setAttribute('aria-selected', String(i === active)),
    );
    const current = options[active];
    if (current) {
      input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
    } else {
      input.removeAttribute('aria-activedescendant');
    }
  };

  const render = (items: PagefindResult[], message: string) => {
    if (!list || !status || !input) return;
    urls = items.map((item) => item.url);
    list.replaceChildren(
      ...items.map((item, i) => {
        const option = document.createElement('a');
        option.id = `blog-search-option-${i}`;
        option.href = item.url;
        option.className = 'search-option';
        option.tabIndex = -1;
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', 'false');
        const title = document.createElement('span');
        title.className = 'search-option-title';
        title.textContent = item.meta.title ?? item.url;
        const excerpt = document.createElement('span');
        excerpt.className = 'search-option-excerpt';
        appendExcerpt(item.excerpt, excerpt);
        option.append(title, excerpt);
        option.addEventListener('pointermove', () => {
          if (active !== i) setActive(i);
        });
        return option;
      }),
    );
    list.hidden = items.length === 0;
    input.setAttribute('aria-expanded', String(items.length > 0));
    status.textContent = message;
    setActive(0);
  };

  const runSearch = async () => {
    if (!input) return;
    const query = input.value.trim();
    const mine = ++token;
    if (!query) {
      render([], IDLE);
      return;
    }
    const api = await loadPagefind();
    if (mine !== token) return;
    if (!api) {
      render([], 'Search is unavailable right now.');
      return;
    }
    const response = await api.debouncedSearch(
      query,
      { filters: { section: 'Blog' } },
      150,
    );
    if (response === null || mine !== token) return;
    const items = await Promise.all(
      response.results.slice(0, 8).map((r) => r.data()),
    );
    if (mine !== token) return;
    const n = items.length;
    render(
      items,
      n
        ? `${n} ${n === 1 ? 'post matches' : 'posts match'}.`
        : `No posts match “${query}”.`,
    );
  };

  const open = (from?: HTMLElement | null) => {
    if (!dialog || !input || dialog.open) return;
    opener = from ?? (document.activeElement as HTMLElement | null);
    void loadPagefind();
    dialog.showModal();
    input.value = '';
    render([], IDLE);
    input.focus();
  };

  const close = () => {
    if (dialog?.open) dialog.close();
  };

  dialog?.addEventListener('close', () => {
    token++;
    opener?.focus();
    opener = null;
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });
  dialog
    ?.querySelector('[data-blog-search-close]')
    ?.addEventListener('click', close);
  input?.addEventListener('input', () => void runSearch());
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === 'Escape') {
      // A search input swallows Esc to clear itself; close in one press.
      event.preventDefault();
      close();
    }
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const url = urls[active];
    if (url) window.location.href = url;
  });

  for (const trigger of document.querySelectorAll<HTMLElement>(
    '[data-blog-search-open]',
  )) {
    trigger.addEventListener('click', () => open(trigger));
    // Warm the index on intent, never on load.
    trigger.addEventListener('pointerenter', () => void loadPagefind(), {
      once: true,
    });
    trigger.addEventListener('focus', () => void loadPagefind(), {
      once: true,
    });
  }

  const isTyping = (el: Element | null) =>
    el instanceof HTMLElement &&
    (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) close();
      else open();
    } else if (
      event.key === '/' &&
      !dialog?.open &&
      !isTyping(document.activeElement)
    ) {
      event.preventDefault();
      open();
    }
  });
</script>
