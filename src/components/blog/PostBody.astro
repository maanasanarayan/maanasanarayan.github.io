---
/**
 * Renders a post's <Content /> (passed as the default slot) and enhances the
 * HTML at build time, so the browser gets final markup and nothing shifts:
 *
 * - h2/h3 headings become self-links ("#" glyph via CSS) for deep linking.
 * - Code blocks get a "Copy" button. It ships `hidden` and is revealed by
 *   PostEnhancements once the Clipboard API is known to work; it is absolutely
 *   positioned, so revealing it causes no layout shift.
 *
 * Works for .md, .mdx and .mdoc alike because it only sees rendered HTML.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const raw = await Astro.slots.render('default');

const COPY_BUTTON =
  '<button type="button" class="copy-code" data-copy-code aria-label="Copy code to clipboard" hidden>Copy</button>';

const html = raw
  .replace(
    /<h([23])\b([^>]*\bid="([^"]+)"[^>]*)>([\s\S]*?)<\/h\1>/g,
    (match, level: string, attrs: string, id: string, inner: string) =>
      /<a\b/i.test(inner)
        ? match
        : `<h${level}${attrs}><a class="heading-anchor" href="#${id}">${inner}</a></h${level}>`,
  )
  .replace(
    /<pre\b(?![^>]*\bclass="mermaid")([^>]*)>([\s\S]*?)<\/pre>/g,
    (_match, attrs: string, inner: string) =>
      `<div class="code-block">${COPY_BUTTON}<pre${attrs}>${inner}</pre></div>`,
  );
---

<div class:list={['neo-prose', className]} set:html={html} />
