---
import { ArrowRight } from 'lucide-astro';

interface Props {
  title?: string;
  message?: string;
  link?: { href: string; label: string };
}

const {
  title = 'Nothing on the walls yet',
  message = 'The pieces are being photographed and catalogued. They will go up here one by one.',
  link,
} = Astro.props;
---

<div class="grid grid-cols-1 border-4 border-black bg-white shadow-[8px_8px_0_0_#000] sm:shadow-[12px_12px_0_0_#000] md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
  <div
    class="halftone-bg bg-neo-muted grid place-items-center border-b-4 border-black p-8 sm:p-12 md:border-r-4 md:border-b-0"
    aria-hidden="true"
  >
    <div class="grid aspect-[4/5] w-40 rotate-[-2deg] place-items-center border-4 border-dashed border-black bg-white/80 shadow-[6px_6px_0_0_#000] sm:w-48">
      <span class="text-neo-bg border-2 border-black bg-black px-2 py-0.5 tabular-nums text-[11px] font-bold tracking-widest uppercase">
        Space reserved
      </span>
    </div>
  </div>
  <div class="flex flex-col justify-center gap-4 p-6 sm:p-10">
    <h2 class="font-display text-3xl leading-none tracking-tight uppercase sm:text-4xl">
      {title}
    </h2>
    <p class="max-w-md text-base leading-snug font-medium sm:text-lg">
      {message}
    </p>
    {link && (
      <a
        href={link.href}
        class="bg-neo-secondary inline-flex w-fit items-center gap-2 border-4 border-black px-4 py-2 text-xs font-bold tracking-widest uppercase shadow-[4px_4px_0_0_#000] transition-all duration-100 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_#000] focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-black focus-visible:outline-dashed"
      >
        {link.label}
        <ArrowRight class="h-4 w-4 stroke-[3px]" />
      </a>
    )}
  </div>
</div>
