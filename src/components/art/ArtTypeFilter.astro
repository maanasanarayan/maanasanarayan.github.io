---
import {
  ART_HEX,
  ART_URL,
  artTypeUrl,
  type ArtTypeWithCount,
} from '../../lib/art';

interface Props {
  counts: ArtTypeWithCount[];
  total: number;
  /** Current type id, or undefined on the main gallery. */
  active?: string;
}

const { counts, total, active } = Astro.props;
// Hide forms with nothing in them yet, but always keep the current one.
const visible = counts.filter((c) => c.count > 0 || c.type.id === active);

const base =
  'inline-flex items-center gap-2 border-[3px] border-black px-3 py-1.5 text-xs font-bold tracking-widest uppercase transition-[translate,box-shadow,background-color] duration-100 focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-black focus-visible:outline-dashed sm:text-sm';
const idle =
  'bg-white shadow-[3px_3px_0_0_#000] hover:-translate-y-0.5 hover:shadow-[5px_5px_0_0_#000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none';
const current = 'text-neo-bg bg-black shadow-[3px_3px_0_0_#FFD93D]';
---

<nav aria-label="Filter by art form">
  <ul class="flex flex-wrap gap-2.5 sm:gap-3" role="list">
    <li>
      <a
        href={ART_URL}
        class:list={[base, active ? idle : current]}
        aria-current={active ? undefined : 'page'}
      >
        All
        <span class="tabular-nums text-[11px] opacity-80">{total}</span>
      </a>
    </li>
    {visible.map(({ type, count }) => {
      const isActive = type.id === active;
      return (
        <li>
          <a
            href={artTypeUrl(type.id)}
            class:list={[base, isActive ? current : idle]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span
              aria-hidden="true"
              class="inline-block h-3 w-3 border-2 border-black"
              style={`background:${ART_HEX[type.data.color]}`}
            />
            {type.data.name}
            <span class="tabular-nums text-[11px] opacity-80">{count}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
