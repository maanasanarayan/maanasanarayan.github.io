---
import { ArrowUpRight } from 'lucide-astro';
import {
  ART_HEX,
  artTypeUrl,
  pluralPieces,
  type ArtTypeWithCount,
} from '../../lib/art';

interface Props {
  counts: ArtTypeWithCount[];
  headingLevel?: 'h2' | 'h3';
}

const { counts, headingLevel: Heading = 'h3' } = Astro.props;
const visible = counts.filter((c) => c.count > 0);
---

{visible.length > 0 && (
  <aside
    aria-labelledby="art-forms-title"
    class="bg-neo-mint border-4 border-black p-5 shadow-[8px_8px_0_0_#000] sm:col-span-2 sm:p-6 lg:col-span-1"
  >
    <Heading
      id="art-forms-title"
      class="font-display text-xl leading-none tracking-tight uppercase sm:text-2xl"
    >
      The forms
    </Heading>
    <ul
      class="mt-4 divide-y-2 divide-black border-y-2 border-black"
      role="list"
    >
      {visible.map(({ type, count }) => (
        <li>
          <a
            href={artTypeUrl(type.id)}
            class="group hover:bg-neo-bg focus-visible:bg-neo-bg flex items-start gap-3 py-3 outline-none sm:px-1"
          >
            <span
              aria-hidden="true"
              class="mt-1 inline-block h-4 w-4 shrink-0 border-2 border-black"
              style={`background:${ART_HEX[type.data.color]}`}
            />
            <span class="min-w-0 flex-1">
              <span class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-bold tracking-widest uppercase underline-offset-4 group-hover:underline group-focus-visible:underline">
                  {type.data.name}
                </span>
                <span class="tabular-nums text-[11px] font-bold tracking-wider uppercase">
                  {pluralPieces(count)}
                </span>
              </span>
              <span class="mt-0.5 block text-sm leading-snug font-medium">
                {type.data.description}
              </span>
            </span>
            <ArrowUpRight
              aria-hidden="true"
              class="mt-0.5 h-4 w-4 shrink-0 stroke-[3px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
