---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import NavBar from '../components/react/NavBar.jsx';
import Footer from '../components/Footer.astro';
import content from '../data/content.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  /** When true, navbar links scroll to in-page sections (#about, etc). */
  isHome?: boolean;
}

const {
  title = 'Maanasa Narayan — Software Engineer Portfolio',
  description = 'Software Engineer at Google in the Bay Area, CA, working on Search. Previously: Kayak, Amazon, Nokia, Adobe.',
  image = '/images/maanasan.jpg',
  type = 'website',
  publishedTime,
  isHome = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const markdownAlternateURL =
  cleanPath === '/' ? '/index.md' : `${cleanPath}/index.md`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Maanasa Narayan" />
    <meta
      name="keywords"
      content="Maanasa Narayan, software engineer, Google, full stack developer, Bay Area, Mountain View, React, Java, AWS, portfolio, Kayak, Amazon, Adobe, Nokia"
    />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="text/markdown" href={markdownAlternateURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="me" href="https://www.linkedin.com/in/maanasa-narayan/" />
    <link rel="me" href="https://github.com/maanasanarayan" />
    <link rel="me" href="https://x.com/maanasa_narayan" />
    <link rel="author" href="https://maanasa.dev/" />

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FFD93D" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Maanasa Narayan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="Portrait of Maanasa Narayan, Software Engineer"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={new Date(publishedTime).toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maanasa_narayan" />
    <meta name="twitter:creator" content="@maanasa_narayan" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Portrait of Maanasa Narayan, Software Engineer"
    />

    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-archivo-black" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Structured Data: Person & Organization with contactPoint and address -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://maanasa.dev/#website',
            url: 'https://maanasa.dev/',
            name: 'Maanasa Narayan',
            description: description,
            inLanguage: 'en',
            publisher: {
              '@id': 'https://maanasa.dev/#organization',
            },
          },
          {
            '@type': 'ProfilePage',
            '@id': `${canonicalURL}#profilepage`,
            url: canonicalURL,
            name: title,
            isPartOf: {
              '@id': 'https://maanasa.dev/#website',
            },
            mainEntity: {
              '@id': 'https://maanasa.dev/#person',
            },
          },
          {
            '@type': 'Person',
            '@id': 'https://maanasa.dev/#person',
            name: 'Maanasa Narayan',
            url: 'https://maanasa.dev/',
            image: 'https://maanasa.dev/images/maanasan.jpg',
            jobTitle: 'Software Engineer',
            description:
              'Software Engineer at Google (Search AI Mode) focused on building scalable web applications and backend cloud systems.',
            email: 'mailto:mnsnryn@gmail.com',
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Mountain View',
              addressRegion: 'CA',
              addressCountry: 'US',
            },
            contactPoint: {
              '@type': 'ContactPoint',
              contactType: 'professional inquiries',
              email: 'mnsnryn@gmail.com',
              url: 'https://maanasa.dev/#contact',
              availableLanguage: ['English'],
            },
            sameAs: [
              'https://www.linkedin.com/in/maanasa-narayan/',
              'https://github.com/maanasanarayan',
              'https://x.com/maanasa_narayan',
            ],
            alumniOf: [
              {
                '@type': 'CollegeOrUniversity',
                name: 'Northeastern University',
                sameAs: 'https://www.northeastern.edu/',
              },
              { '@type': 'CollegeOrUniversity', name: 'KSIT, VTU' },
            ],
            worksFor: {
              '@type': 'Organization',
              name: 'Google',
              sameAs: 'https://www.google.com/',
              address: {
                '@type': 'PostalAddress',
                addressLocality: 'Mountain View',
                addressRegion: 'CA',
                addressCountry: 'US',
              },
              contactPoint: {
                '@type': 'ContactPoint',
                contactType: 'general inquiries',
                url: 'https://about.google/contact-google/',
              },
            },
            knowsAbout: [
              'Software Engineering',
              'Java',
              'Python',
              'JavaScript',
              'TypeScript',
              'React',
              'Node.js',
              'AWS',
              'Cloud Infrastructure',
              'RESTful APIs',
              'Backend Systems',
              'CI/CD',
            ],
          },
          {
            '@type': 'Organization',
            '@id': 'https://maanasa.dev/#organization',
            name: 'Maanasa Narayan',
            url: 'https://maanasa.dev/',
            logo: 'https://maanasa.dev/images/maanasan.jpg',
            email: 'mailto:mnsnryn@gmail.com',
            founder: {
              '@id': 'https://maanasa.dev/#person',
            },
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Mountain View',
              addressRegion: 'CA',
              addressCountry: 'US',
            },
            contactPoint: {
              '@type': 'ContactPoint',
              contactType: 'customer service',
              email: 'mnsnryn@gmail.com',
              url: 'https://maanasa.dev/#contact',
              availableLanguage: ['English'],
            },
            sameAs: [
              'https://www.linkedin.com/in/maanasa-narayan/',
              'https://github.com/maanasanarayan',
              'https://x.com/maanasa_narayan',
            ],
          },
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonicalURL}#breadcrumbs`,
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Home',
                item: 'https://maanasa.dev/',
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: title,
                item: canonicalURL,
              },
            ],
          },
          {
            '@type': 'FAQPage',
            '@id': `${canonicalURL}#faq`,
            mainEntity: [
              {
                '@type': 'Question',
                name: "What is Maanasa Narayan's current role and company?",
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Maanasa Narayan is a Software Engineer at Google working on Search (AI Mode) in Mountain View / Bay Area, CA.',
                },
              },
              {
                '@type': 'Question',
                name: 'What is Maanasa Narayan’s educational background?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Maanasa holds a Master of Science in Computer Science from Northeastern University (GPA 3.9/4.0) and a Bachelor of Engineering in Computer Science from KSIT, VTU.',
                },
              },
              {
                '@type': 'Question',
                name: 'What technical skills and frameworks does Maanasa specialize in?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Maanasa specializes in Java, Python, TypeScript, JavaScript, React, Node.js, Spring Boot, AWS Lambda, Kubernetes, Docker, Elasticsearch, CI/CD, and REST APIs.',
                },
              },
              {
                '@type': 'Question',
                name: 'Where has Maanasa worked prior to Google?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Prior to Google, Maanasa worked at Kayak (airline integration services), Amazon (AWS Lambda automation), Nokia (application developer), Adobe (core software engineering), and Infosys.',
                },
              },
              {
                '@type': 'Question',
                name: 'How can recruiters, agents, or collaborators get in touch with Maanasa?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Reach out via email at mnsnryn@gmail.com, connect on LinkedIn at https://www.linkedin.com/in/maanasa-narayan/, or view code on GitHub at https://github.com/maanasanarayan.',
                },
              },
            ],
          },
          {
            '@type': 'Service',
            '@id': 'https://maanasa.dev/#service',
            name: 'Software Engineering & Cloud Architecture',
            serviceType: 'Software Engineering',
            provider: {
              '@id': 'https://maanasa.dev/#person',
            },
            areaServed: 'Worldwide',
            description:
              'Full stack software engineering, scalable cloud microservices, and search infrastructure.',
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: '5.0',
              reviewCount: '4',
            },
            review: [
              {
                '@type': 'Review',
                author: {
                  '@type': 'Person',
                  name: 'Engineering Colleague at Kayak',
                },
                reviewRating: { '@type': 'Rating', ratingValue: '5' },
                reviewBody:
                  'Maanasa delivered critical airline integration services with outstanding attention to high throughput, reliability, and automated CI/CD testing.',
              },
              {
                '@type': 'Review',
                author: {
                  '@type': 'Person',
                  name: 'Senior Engineer at Amazon',
                },
                reviewRating: { '@type': 'Rating', ratingValue: '5' },
                reviewBody:
                  'Developed an impactful internal automation tool on AWS Lambda that saved dozens of engineering hours per sprint.',
              },
            ],
          },
        ],
      })}
    />
    <script is:inline>
      // WebMCP browser-resident AI agent tool registration (W3C draft)
      (function () {
        function registerWebMcpTools() {
          const mc =
            typeof document !== 'undefined' && document.modelContext
              ? document.modelContext
              : typeof navigator !== 'undefined' && navigator.modelContext
                ? navigator.modelContext
                : null;
          if (mc && typeof mc.registerTool === 'function') {
            try {
              mc.registerTool({
                name: 'get_portfolio_profile',
                description:
                  'Query verified profile, roles, and education for Maanasa Narayan',
                parameters: { type: 'object', properties: {} },
                handler: async () => {
                  const res = await fetch('/api/profile');
                  return res.json();
                },
              });
              mc.registerTool({
                name: 'ask_maanasa_ai',
                description:
                  'Ask natural language questions about Maanasa Narayan via NLWeb',
                parameters: {
                  type: 'object',
                  properties: { query: { type: 'string' } },
                  required: ['query'],
                },
                handler: async ({ query }) => {
                  const res = await fetch('/ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query }),
                  });
                  return res.json();
                },
              });
            } catch (err) {
              console.debug('WebMCP registration:', err);
            }
          }
        }
        if (typeof document !== 'undefined') {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', registerWebMcpTools);
          } else {
            registerWebMcpTools();
          }
        }
      })();
    </script>
    <slot name="head" />
    <ClientRouter />
  </head>

  <body>
    <NavBar
      name={content.profile.name}
      isHome={isHome}
      currentPath={Astro.url.pathname}
      transition:persist
      client:idle
    />

    <main transition:animate="slide">
      <slot />
    </main>

    <Footer name={content.profile.name} />
  </body>
</html>
