---
import BlogLayout from '../../../components/blog/BlogLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import { ArrowLeft } from 'lucide-astro';
import { SITE_URL, getPosts, getTags } from '../../../lib/blog';

const posts = await getPosts();
const tags = getTags(posts);
const url = `${SITE_URL}/blog/tags/`;
const title = 'All blog tags — Maanasa Narayan';
const postCount = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
const description = `Browse ${postCount} on Maanasa Narayan’s blog by topic${
  tags.length
    ? `: ${tags
        .slice(0, 6)
        .map((t) => t.tag)
        .join(', ')}`
    : ''
}.`;
const tones = [
  'bg-neo-secondary',
  'bg-neo-mint',
  'bg-neo-sky',
  'bg-neo-muted',
  'bg-white',
];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#collection`,
    url,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE_URL}/blog/#blog` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tags.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${url}${t.slug}/`,
        name: t.tag,
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#blog-breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: `${SITE_URL}/blog/`,
      },
      { '@type': 'ListItem', position: 3, name: 'Tags', item: url },
    ],
  },
];
---

<BlogLayout title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 pt-28 pb-20 sm:px-6 sm:pt-36 sm:pb-24 lg:px-8">
    <a
      href="/blog/"
      class="mb-8 inline-flex items-center gap-2 border-2 border-black bg-white px-3 py-1.5 text-xs font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all duration-100 hover:-translate-y-0.5"
    >
      <ArrowLeft class="h-4 w-4 stroke-[3px]" aria-hidden="true" />
      All posts
    </a>
    <SectionHeader kicker="Browse by topic" title="Tags" as="h1" />

    {tags.length === 0 ? (
      <p class="border-4 border-dashed border-black bg-white p-8 text-center text-lg font-bold">
        No tags yet.
      </p>
    ) : (
      <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {tags.map(({ tag, slug, count }, i) => (
          <li>
            <a
              href={`/blog/tags/${slug}/`}
              class:list={[
                'flex items-center justify-between gap-4 border-4 border-black p-5 shadow-[6px_6px_0_0_#000] transition-[translate,box-shadow] duration-150 hover:-translate-y-1 hover:shadow-[9px_9px_0_0_#000] focus-visible:-translate-y-1 motion-reduce:transition-none',
                tones[i % tones.length],
              ]}
            >
              <span class="font-display text-2xl tracking-tight uppercase">
                <span aria-hidden="true">#</span>
                {tag}
              </span>
              <span class="border-2 border-black bg-black px-2 py-1 text-xs font-bold tracking-widest text-white uppercase">
                {count} {count === 1 ? 'post' : 'posts'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BlogLayout>
