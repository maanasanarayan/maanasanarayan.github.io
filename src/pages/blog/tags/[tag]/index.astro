---
import BlogLayout from '../../../../components/blog/BlogLayout.astro';
import BlogHeader from '../../../../components/blog/BlogHeader.astro';
import PostYearList from '../../../../components/blog/PostYearList.astro';
import {
  SITE_URL,
  getPosts,
  getTags,
  postHref,
  postsWithTag,
} from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, slug },
  }));
}

const { tag, slug } = Astro.props;
const posts = await getPosts();
const tags = getTags(posts);
const tagged = postsWithTag(posts, slug);
const url = `${SITE_URL}/blog/tags/${slug}/`;
const count = `${tagged.length} ${tagged.length === 1 ? 'post' : 'posts'}`;
const title = `Posts tagged #${tag} — Maanasa Narayan`;
const description = `${count} tagged “${tag}” on Maanasa Narayan’s blog: ${tagged
  .slice(0, 3)
  .map((p) => p.data.title)
  .join('; ')}.`;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#collection`,
    url,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE_URL}/blog/#blog` },
    about: { '@type': 'Thing', name: tag },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tagged.map((post, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE_URL}${postHref(post)}`,
        name: post.data.title,
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#blog-breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: `${SITE_URL}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Tags',
        item: `${SITE_URL}/blog/tags/`,
      },
      { '@type': 'ListItem', position: 4, name: `#${tag}`, item: url },
    ],
  },
];
---

<BlogLayout title={title} description={description} schema={schema}>
  <div class="mx-auto max-w-6xl px-4 pt-28 pb-20 sm:px-6 sm:pt-36 sm:pb-24 lg:px-8">
    <BlogHeader kicker="Tagged" title={`#${tag}`} tags={tags} activeTag={slug}>
      <p>
        {count} tagged <strong class="bg-neo-secondary px-1">{tag}</strong>.
      </p>
      <p class="mt-2">
        <a href="/blog/tags/" class="hover:bg-neo-mint border-b-4 border-black">
          Browse every tag
        </a>{' '}
        or go back to{' '}
        <a href="/blog/" class="hover:bg-neo-mint border-b-4 border-black">
          all posts
        </a>
      </p>
    </BlogHeader>
    <PostYearList posts={tagged} />
  </div>
</BlogLayout>
