---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  Shield,
  Lock,
  EyeOff,
  Server,
  Globe,
  Mail,
  ArrowLeft,
} from 'lucide-astro';
import content from '../data/content.js';
---

<SiteLayout
  title="Privacy Policy — Maanasa Narayan"
  description="Privacy Policy for maanasa.dev. Transparent information on data minimization, zero tracking cookies, Cloudflare hosting, and contact practices."
>
  <div
    class="mx-auto max-w-5xl px-4 pt-28 pb-20 sm:px-6 sm:pt-36 sm:pb-24 lg:px-8"
  >
    <div class="mb-8">
      <a
        href="/"
        class="inline-flex items-center gap-2 border-2 border-black bg-white px-3 py-1.5 text-xs font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all duration-100 hover:-translate-y-0.5"
      >
        <ArrowLeft class="h-4 w-4 stroke-[3px]" />
        Back to Home
      </a>
    </div>

    <article
      class="border-4 border-black bg-white p-6 shadow-[8px_8px_0_0_#000] sm:p-10 sm:shadow-[12px_12px_0_0_#000] lg:p-12"
    >
      <span
        class="bg-neo-secondary inline-block border-4 border-black px-3 py-1 text-xs font-bold tracking-widest uppercase shadow-[4px_4px_0_0_#000]"
      >
        Legal & Privacy
      </span>

      <h1
        class="font-display mt-6 text-4xl leading-tight tracking-tight uppercase sm:text-6xl lg:text-7xl"
      >
        Privacy Policy.
      </h1>

      <p class="mt-4 text-xs font-bold tracking-widest text-black/70 uppercase">
        Effective Date: January 1, 2026 · Last Updated: August 23, 2026
      </p>

      <div
        class="mt-8 space-y-10 border-t-4 border-black pt-8 text-base leading-relaxed font-medium text-black/90 sm:text-lg"
      >
        <section>
          <div class="flex items-center gap-3">
            <span
              class="bg-neo-mint grid h-9 w-9 place-items-center border-2 border-black"
            >
              <Shield class="h-4 w-4 stroke-[3px]" />
            </span>
            <h2
              class="font-display text-2xl tracking-tight uppercase sm:text-3xl"
            >
              1. Overview & Commitment to Privacy
            </h2>
          </div>
          <p class="mt-4">
            This Privacy Policy explains how <strong>https://maanasa.dev</strong
            > (the &ldquo;Website&rdquo;), a personal portfolio and software engineering
            site authored by Maanasa Narayan (&ldquo;I&rdquo;, &ldquo;me&rdquo;),
            handles visitor information. I prioritize data minimization and user privacy:
            this site is built to provide information regarding my engineering career,
            technical projects, skills, and publications without tracking you across
            the web.
          </p>
        </section>

        <section>
          <div class="flex items-center gap-3">
            <span
              class="bg-neo-accent grid h-9 w-9 place-items-center border-2 border-black text-white"
            >
              <EyeOff class="h-4 w-4 stroke-[3px]" />
            </span>
            <h2
              class="font-display text-2xl tracking-tight uppercase sm:text-3xl"
            >
              2. Information We Collect
            </h2>
          </div>

          <div class="mt-4 space-y-4">
            <h3 class="font-display text-xl tracking-tight uppercase">
              A. Technical & Server Log Data
            </h3>
            <p>
              When you browse this website, our Content Delivery Network (CDN)
              automatically records basic network diagnostic logs necessary to
              deliver web traffic and mitigate attacks. These logs may
              temporarily contain:
            </p>
            <ul class="list-disc space-y-1 pl-6 text-base">
              <li>Internet Protocol (IP) address</li>
              <li>Date, timestamp, and HTTP response status code</li>
              <li>Requested resource path and HTTP method</li>
              <li>
                Browser User-Agent header (operating system, browser type, or AI
                crawler identity)
              </li>
              <li>Referring website address</li>
            </ul>

            <h3 class="font-display mt-6 text-xl tracking-tight uppercase">
              B. Information You Voluntarily Provide
            </h3>
            <p>
              If you contact me via email (<a
                href={`mailto:${content.contact.email}`}
                class="font-bold underline">{content.contact.email}</a
              >), LinkedIn, GitHub, or X, you share communication details (e.g.,
              your name, email address, and message). This information is used
              strictly to read, evaluate, and reply to your communication. Your
              contact details are never sold, rented, or shared with third-party
              advertisers.
            </p>
          </div>
        </section>

        <section>
          <div class="flex items-center gap-3">
            <span
              class="bg-neo-sky grid h-9 w-9 place-items-center border-2 border-black"
            >
              <Lock class="h-4 w-4 stroke-[3px]" />
            </span>
            <h2
              class="font-display text-2xl tracking-tight uppercase sm:text-3xl"
            >
              3. Cookies and Tracking Technologies
            </h2>
          </div>
          <p class="mt-4">
            This website does <strong>not</strong> use advertising cookies, marketing
            pixels, social tracking beacons, or invasive fingerprinting scripts. Any
            local browser storage is restricted strictly to necessary client-side
            navigation enhancements (such as Astro view transition cache states).
          </p>
        </section>

        <section>
          <div class="flex items-center gap-3">
            <span
              class="bg-neo-muted grid h-9 w-9 place-items-center border-2 border-black"
            >
              <Server class="h-4 w-4 stroke-[3px]" />
            </span>
            <h2
              class="font-display text-2xl tracking-tight uppercase sm:text-3xl"
            >
              4. Hosting & Privacy-First Analytics
            </h2>
          </div>
          <p class="mt-4">
            This website is hosted and distributed globally via <strong
              >Cloudflare Pages & Workers</strong
            >. Cloudflare serves as our security proxy and CDN. Aggregate
            visitor traffic may be monitored using <strong
              >Cloudflare Web Analytics</strong
            >, which is non-invasive, does not store cookies, does not collect
            personal identifiers, and respects visitor anonymity.
          </p>
        </section>

        <section>
          <div class="flex items-center gap-3">
            <span
              class="bg-neo-secondary grid h-9 w-9 place-items-center border-2 border-black"
            >
              <Globe class="h-4 w-4 stroke-[3px]" />
            </span>
            <h2
              class="font-display text-2xl tracking-tight uppercase sm:text-3xl"
            >
              5. External Links & AI Agent Crawlers
            </h2>
          </div>
          <p class="mt-4">
            This website contains links to external profiles (LinkedIn, GitHub,
            X, Google). Once you navigate to external domains, their respective
            privacy policies govern your interaction.
          </p>
          <p class="mt-3">
            Additionally, this website supports standard <strong
              >RFC 9110 HTTP content negotiation</strong
            > to serve clean Markdown representations (<code
              class="bg-neo-muted border border-black px-1.5 py-0.5 text-sm"
              >Accept: text/markdown</code
            >) to autonomous AI agents, crawlers, and LLMs in compliance with
            published <a href="/llms.txt" class="font-bold underline"
              >llms.txt</a
            > guidelines.
          </p>
        </section>

        <section>
          <div class="flex items-center gap-3">
            <span
              class="bg-neo-mint grid h-9 w-9 place-items-center border-2 border-black"
            >
              <Mail class="h-4 w-4 stroke-[3px]" />
            </span>
            <h2
              class="font-display text-2xl tracking-tight uppercase sm:text-3xl"
            >
              6. Contact & Privacy Inquiries
            </h2>
          </div>
          <p class="mt-4">
            If you have questions, feedback, or requests regarding this Privacy
            Policy or your data, please contact:
          </p>
          <div class="bg-neo-muted mt-4 border-2 border-black p-4">
            <p class="font-bold">Maanasa Narayan</p>
            <p class="mt-1">
              Email: <a
                href={`mailto:${content.contact.email}`}
                class="font-bold underline">{content.contact.email}</a
              >
            </p>
            <p>Location: Mountain View / San Francisco Bay Area, CA, USA</p>
            <p>
              Website: <a
                href="https://maanasa.dev/"
                class="font-bold underline">https://maanasa.dev/</a
              >
            </p>
          </div>
        </section>
      </div>
    </article>
  </div>
</SiteLayout>
