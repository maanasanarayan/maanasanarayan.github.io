---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  Mail,
  Linkedin,
  Github,
  Twitter,
  MapPin,
  Clock,
  MessageSquare,
  ArrowLeft,
} from 'lucide-astro';
import content from '../data/content.js';
---

<SiteLayout
  title="Contact Maanasa Narayan — Software Engineer"
  description="Get in touch with Maanasa Narayan for engineering inquiries, technical discussions, speaking opportunities, or collaboration."
>
  <div
    class="mx-auto max-w-5xl px-4 pt-28 pb-20 sm:px-6 sm:pt-36 sm:pb-24 lg:px-8"
  >
    <div class="mb-8">
      <a
        href="/"
        class="inline-flex items-center gap-2 border-2 border-black bg-white px-3 py-1.5 text-xs font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all duration-100 hover:-translate-y-0.5"
      >
        <ArrowLeft class="h-4 w-4 stroke-[3px]" />
        Back to Home
      </a>
    </div>

    <article
      class="border-4 border-black bg-white p-6 shadow-[8px_8px_0_0_#000] sm:p-10 sm:shadow-[12px_12px_0_0_#000] lg:p-12"
    >
      <span
        class="bg-neo-accent inline-block border-4 border-black px-3 py-1 text-xs font-bold tracking-widest text-black uppercase shadow-[4px_4px_0_0_#000]"
      >
        Contact & Inquiries
      </span>

      <h1
        class="font-display mt-6 text-4xl leading-tight tracking-tight uppercase sm:text-6xl lg:text-7xl"
      >
        Let&rsquo;s Connect.
      </h1>

      <p
        class="mt-6 max-w-2xl text-base leading-relaxed font-medium text-black/90 sm:text-lg"
      >
        Whether you are reaching out regarding software engineering roles,
        technical architecture collaboration, speaking invitations, mentorship,
        or discussing distributed backend systems, I would love to hear from
        you.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div
          class="bg-neo-secondary border-4 border-black p-6 shadow-[4px_4px_0_0_#000]"
        >
          <div class="flex items-center gap-3">
            <span
              class="grid h-10 w-10 place-items-center border-2 border-black bg-white"
            >
              <Mail class="h-5 w-5 stroke-[3px]" />
            </span>
            <div>
              <h2 class="font-display text-xl tracking-tight uppercase">
                Direct Email
              </h2>
              <span
                class="text-xs font-bold tracking-widest uppercase opacity-75"
                >Primary contact method</span
              >
            </div>
          </div>
          <p class="mt-4 text-base leading-snug font-medium">
            For detailed inquiries, opportunities, and professional
            correspondence:
          </p>
          <a
            href={`mailto:${content.contact.email}`}
            class="mt-4 inline-block border-2 border-black bg-white px-4 py-2 text-sm font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all hover:-translate-y-0.5"
          >
            {content.contact.email} &rarr;
          </a>
        </div>

        <div
          class="bg-neo-mint border-4 border-black p-6 shadow-[4px_4px_0_0_#000]"
        >
          <div class="flex items-center gap-3">
            <span
              class="grid h-10 w-10 place-items-center border-2 border-black bg-white"
            >
              <Linkedin class="h-5 w-5 stroke-[3px]" />
            </span>
            <div>
              <h2 class="font-display text-xl tracking-tight uppercase">
                LinkedIn
              </h2>
              <span
                class="text-xs font-bold tracking-widest uppercase opacity-75"
                >Professional network</span
              >
            </div>
          </div>
          <p class="mt-4 text-base leading-snug font-medium">
            Connect for career networking, recommendations, and verified
            professional background:
          </p>
          <a
            href={content.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block border-2 border-black bg-white px-4 py-2 text-sm font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all hover:-translate-y-0.5"
          >
            linkedin.com/in/maanasa-narayan &rarr;
          </a>
        </div>

        <div
          class="bg-neo-muted border-4 border-black p-6 shadow-[4px_4px_0_0_#000]"
        >
          <div class="flex items-center gap-3">
            <span
              class="grid h-10 w-10 place-items-center border-2 border-black bg-white"
            >
              <Github class="h-5 w-5 stroke-[3px]" />
            </span>
            <div>
              <h2 class="font-display text-xl tracking-tight uppercase">
                GitHub
              </h2>
              <span
                class="text-xs font-bold tracking-widest uppercase opacity-75"
                >Code & repositories</span
              >
            </div>
          </div>
          <p class="mt-4 text-base leading-snug font-medium">
            Explore open source repositories, projects, and codebase
            experiments:
          </p>
          <a
            href={content.contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block border-2 border-black bg-white px-4 py-2 text-sm font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all hover:-translate-y-0.5"
          >
            github.com/maanasanarayan &rarr;
          </a>
        </div>

        <div
          class="bg-neo-sky border-4 border-black p-6 shadow-[4px_4px_0_0_#000]"
        >
          <div class="flex items-center gap-3">
            <span
              class="grid h-10 w-10 place-items-center border-2 border-black bg-white"
            >
              <Twitter class="h-5 w-5 stroke-[3px]" />
            </span>
            <div>
              <h2 class="font-display text-xl tracking-tight uppercase">
                X (Twitter)
              </h2>
              <span
                class="text-xs font-bold tracking-widest uppercase opacity-75"
                >Social & quick updates</span
              >
            </div>
          </div>
          <p class="mt-4 text-base leading-snug font-medium">
            Follow tech discussions, software thoughts, and industry
            developments:
          </p>
          <a
            href={content.contact.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block border-2 border-black bg-white px-4 py-2 text-sm font-bold tracking-widest uppercase shadow-[3px_3px_0_0_#000] transition-all hover:-translate-y-0.5"
          >
            {content.contact.twitterHandle} &rarr;
          </a>
        </div>
      </div>

      <div class="mt-12 border-t-4 border-black pt-10">
        <h2 class="font-display text-2xl tracking-tight uppercase sm:text-3xl">
          Availability & Guidelines
        </h2>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div
            class="border-2 border-black bg-white p-4 shadow-[3px_3px_0_0_#000]"
          >
            <div class="flex items-center gap-2">
              <MapPin class="h-4 w-4 stroke-[3px]" />
              <h3 class="font-display text-sm tracking-tight uppercase">
                Location
              </h3>
            </div>
            <p class="mt-2 text-sm font-medium">
              Mountain View / San Francisco Bay Area, CA (Pacific Time, UTC-7 /
              UTC-8).
            </p>
          </div>

          <div
            class="border-2 border-black bg-white p-4 shadow-[3px_3px_0_0_#000]"
          >
            <div class="flex items-center gap-2">
              <Clock class="h-4 w-4 stroke-[3px]" />
              <h3 class="font-display text-sm tracking-tight uppercase">
                Response Time
              </h3>
            </div>
            <p class="mt-2 text-sm font-medium">
              I aim to reply to professional inquiries and collaborative
              proposals within 1–2 business days.
            </p>
          </div>

          <div
            class="border-2 border-black bg-white p-4 shadow-[3px_3px_0_0_#000]"
          >
            <div class="flex items-center gap-2">
              <MessageSquare class="h-4 w-4 stroke-[3px]" />
              <h3 class="font-display text-sm tracking-tight uppercase">
                Topics
              </h3>
            </div>
            <p class="mt-2 text-sm font-medium">
              Backend systems, search architecture, cloud infrastructure, full
              stack web apps, mentorship.
            </p>
          </div>
        </div>
      </div>
    </article>
  </div>
</SiteLayout>
