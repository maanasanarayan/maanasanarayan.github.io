{
  "name": "maanasa-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://maanasa.dev",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun build src/worker.ts --outfile=dist/client/_worker.js --target=browser && node scripts/postbuild.mjs && pagefind --site dist/client",
    "preview": "bun run build && wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . && markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#dist\" \"#.astro\"",
    "lint:fix": "eslint . --fix && markdownlint-cli2 --fix \"**/*.{md,mdx}\" \"#node_modules\" \"#dist\" \"#.astro\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "generate-types": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "import:instagram": "node scripts/import-instagram.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/markdoc": "^2.1.2",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@pagefind/default-ui": "^1.5.2",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "vite": "^8.3.5"
  }
}
